# AutoBreadboard local environment template.
# Copy this file to `.env` (git-ignored) and fill in real values. The Settings
# class in `backend/app/settings.py` reads .env ONLY when ENVIRONMENT=development.
# In staging/production every value below is supplied by Kubernetes
# ConfigMap/Secret-injected environment variables (addendum §4.3).
#
# Env var names are the field names uppercased, no prefix.

# --- Environment & logging ---------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Persistence -------------------------------------------------------------
# Local docker-compose stack — host names match compose service names.
DATABASE_URL=postgresql+asyncpg://autobreadboard:autobreadboard@localhost:5432/autobreadboard
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO in dev) -------------------------------------------
# Override S3_ENDPOINT_URL to point at a hosted S3/MinIO in staging/production.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=autobreadboard
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true

# --- HTTP API ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# pydantic-settings parses list[str] from JSON arrays. Keep the quoting.
CORS_ORIGINS=["http://localhost:8080"]
TRUSTED_HOSTS=["localhost"]

# --- Solver & worker ---------------------------------------------------------
SOLVER_DEFAULT_TIMEOUT_SECONDS=60
SOLVER_MAX_TIMEOUT_SECONDS=600
WORKER_CONCURRENCY=1
WORKER_METRICS_PORT=9100
WORKER_HEARTBEAT_PATH=/tmp/worker-heartbeat
JOB_LOCK_TTL_SECONDS=900
EXPORT_RETENTION_DAYS=7

# --- Build identity (set by CI, never here in dev) ---------------------------
BUILD_SHA=unknown
IMAGE_TAG=unknown

# --- Telemetry ---------------------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable OTLP export entirely.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318